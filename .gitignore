# Ignore the entire results folder (Maps and GeoJSONs)
results/

# Ignore the heavy graph and elevation caches
cache/
*.graphml
*_network_elevations.json
*_training_elevations.json

# Ignore the raw Excel data (optional, but good if it's large)
data/*.xlsx

# Ignore Python environment and bytecode
__pycache__/
*.pyc
.venv/